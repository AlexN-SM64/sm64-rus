 cc: OPT_CFLAGS := -O2
diff --git a/util.mk b/util.mk
index 75af981..295625d 100644
--- a/util.mk
+++ b/util.mk
@@ -14,3 +14,8 @@ endef
 
 # Returns the path to the command $(1) if exists. Otherwise returns an empty string.
 find-command = $(shell which $(1) 2>/dev/null)
+
+# Find that GCC version is 13 or is in machine x86_64-linux-gnu-
+ifneq ($(call find-command,gcc-13),)
+  CC_VERSION := -13
+endif
